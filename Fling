local camera = Workspace.CurrentCamera

local orbiting            = false
local orbitConnection     = nil
local orbitHumanoidRootPart
local currentTargetHRP

local orbitBaseSpeed      = 500
local orbitBaseRadius     = 3

local orbitSemiMajor      = 3
local orbitSemiMinor      = 3
local orbitVerticalAmp    = 0
local orbitVerticalFreq   = 1
local orbitYawOffsetDeg   = 0
local orbitRollEnabled    = false
local orbitPitchEnabled   = false
local orbitYawEnabled     = true
local orbitSpeedScale     = 1

local uiOrbitSpeed        = 500
local uiOrbitRadius       = 3

local function getNearestTargetHRP()
    local nearest
    local minDist = math.huge
    if not orbitHumanoidRootPart then return nil end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (orbitHumanoidRootPart.Position - hrp.Position).Magnitude
                if d < minDist then
                    minDist = d
                    nearest = hrp
                end
            end
        end
    end
    return nearest
end

local function stopOrbit()
    orbiting = false
    if orbitConnection then
        orbitConnection:Disconnect()
        orbitConnection = nil
    end
    currentTargetHRP = nil

    local hum = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        camera.CameraSubject = hum
    end

    UpdateOrbitStatus(false, nil, uiOrbitSpeed, uiOrbitRadius)
    Message("Orbit", "Orbit stopped.", 2)
end

local function startOrbitNearest()
    if orbiting then
        stopOrbit()
        return
    end

    if not orbitHumanoidRootPart or not orbitHumanoidRootPart.Parent then
        Message("Orbit", "Your HumanoidRootPart is missing.", 3)
        return
    end

    currentTargetHRP = getNearestTargetHRP()
    if not currentTargetHRP then
        Message("Orbit", "No valid target found to orbit.", 3)
        return
    end

    orbiting = true

    if orbitConnection then
        orbitConnection:Disconnect()
        orbitConnection = nil
    end

    local t0 = tick()

    orbitConnection = RunService.RenderStepped:Connect(function()
        if not orbiting then return end
        if not orbitHumanoidRootPart or not orbitHumanoidRootPart.Parent then
            stopOrbit()
            return
        end
        if not currentTargetHRP or not currentTargetHRP.Parent then
            currentTargetHRP = getNearestTargetHRP()
            if not currentTargetHRP then
                stopOrbit()
                return
            end
        end

        local now   = tick()
        local dt    = now - t0
        local angle = dt * (orbitBaseSpeed * orbitSpeedScale) / 100

        local a = orbitSemiMajor
        local b = orbitSemiMinor

        local ex = math.cos(angle) * a
        local ez = math.sin(angle) * b

        local yawOffsetRad = math.rad(orbitYawOffsetDeg)
        local rx = ex * math.cos(yawOffsetRad) - ez * math.sin(yawOffsetRad)
        local rz = ex * math.sin(yawOffsetRad) + ez * math.cos(yawOffsetRad)

        local vy = 0
        if orbitVerticalAmp ~= 0 then
            vy = math.sin(angle * orbitVerticalFreq) * orbitVerticalAmp
        end

        local basePos   = currentTargetHRP.Position
        local orbitPos  = basePos + Vector3.new(rx, vy, rz)

        local cf = CFrame.lookAt(orbitPos, basePos)

        local roll  = orbitRollEnabled  and math.sin(angle * 2) * 0.5 or 0
        local pitch = orbitPitchEnabled and math.cos(angle * 1.5) * 0.4 or 0
        local yaw   = orbitYawEnabled   and 0 or 0

        cf = cf * CFrame.Angles(pitch, yaw, roll)

        orbitHumanoidRootPart.CFrame = cf

        local targetHum = currentTargetHRP.Parent:FindFirstChildOfClass("Humanoid")
        if targetHum then
            camera.CameraSubject = targetHum
        end
    end)

    local targetName = currentTargetHRP.Parent and currentTargetHRP.Parent.Name or "Unknown"
    UpdateOrbitStatus(true, targetName, uiOrbitSpeed, uiOrbitRadius)
    Message("Orbit", "Advanced orbit engaged around " .. targetName .. ".", 2)
end

