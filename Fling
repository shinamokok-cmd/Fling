NecessitiesTab:CreateSection("Anti-AFK")

local function disconnectAntiAFK()
    if AntiAFK_Connection then
        pcall(function()
            AntiAFK_Connection:Disconnect()
        end)
        AntiAFK_Connection = nil
    end
end

local function enableAntiAFK()
    disconnectAntiAFK()

    local localPlayer = Players.LocalPlayer
    if not localPlayer then
        Message("Anti-AFK", "LocalPlayer not found.", 3)
        return
    end

    local ok, connOrErr = pcall(function()
        return localPlayer.Idled:Connect(function()
            local vu_success, vu = pcall(function()
                return game:GetService("VirtualUser")
            end)
            if vu_success and vu then
                pcall(function()
                    vu:Button2Down(Vector2.new(0, 0), Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame or CFrame.new())
                    task.wait(0.1)
                    vu:Button2Up(Vector2.new(0, 0), Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame or CFrame.new())
                end)
            end

            pcall(function()
                local cam = Workspace.CurrentCamera
                if cam then
                    cam.CFrame = cam.CFrame * CFrame.Angles(0, math.rad(0.1), 0)
                end
            end)
        end)
    end)

    if ok and connOrErr then
        AntiAFK_Connection = connOrErr
        Message("Anti-AFK", "Anti-AFK enabled.", 3)
    else
        AntiAFK_Connection = nil
        Message("Anti-AFK", "Failed to hook Anti-AFK (executor or game may block it).", 4)
    end
end

local function disableAntiAFK()
    disconnectAntiAFK()
    Message("Anti-AFK", "Anti-AFK disabled.", 3)
end

NecessitiesTab:CreateToggle({
    Name         = "Enable Anti-AFK",
    CurrentValue = false,
    Flag         = "DestinyAntiAFK",
    Callback     = function(Value)
        AntiAFK_Enabled = Value

        if AntiAFK_Enabled then
            enableAntiAFK()
        else
            disableAntiAFK()
        end
    end,
})

NecessitiesTab:CreateSection("Noclip")

local NoclipEnabled = false
local NoclipConnection

local function EnableNoclip()
    if NoclipEnabled then return end
    NoclipEnabled = true

    NoclipConnection = RunService.Stepped:Connect(function()
        local char = Player.Character
        if not char then return end
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)

    Message("Noclip", "Noclip enabled.", 3)
end

local function DisableNoclip()
    if not NoclipEnabled then return end
    NoclipEnabled = false

    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end

    local char = Player.Character
    if char then
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end

    Message("Noclip", "Noclip disabled.", 3)
end

NecessitiesTab:CreateToggle({
    Name         = "Enable Noclip",
    CurrentValue = false,
    Flag         = "DestinyNoclip",
    Callback     = function(Value)
        if Value then
            EnableNoclip()
        else
            DisableNoclip()
        end
    end,
})

