local function FormatTimeSince(t)
    if t == 0 then return "Never" end
    local diff = os.time() - t
    if diff < 1 then return "Just now" end
    if diff < 60 then return diff .. "s ago" end
    local mins = math.floor(diff / 60)
    if mins < 60 then return mins .. "m ago" end
    local hrs = math.floor(mins / 60)
    return hrs .. "h ago"
end

local function UpdateFlingStatus()
    local count = CountSelectedTargets()
