local LocalPlayer2 = Players.LocalPlayer

local function getLocalHRP()
    if not LocalPlayer2 then return nil end
    local char = LocalPlayer2.Character or LocalPlayer2.CharacterAdded:Wait()
    return char:FindFirstChild("HumanoidRootPart")
end

local Waypoints = {}            -- Waypoints[name(string)] = Vector3
local currentWaypointName = nil
local WaypointDropdown = nil

local function notify(title, content)
    Rayfield:Notify({
        Title = tostring(title or "Notice"),
        Content = tostring(content or ""),
        Duration = 4,
        Image = 4483362458
    })
end

local function sanitizeName(raw)
    if type(raw) ~= "string" then
        return ""
    end

    raw = string.gsub(raw, "^%s+", "")
    raw = string.gsub(raw, "%s+$", "")
    raw = string.gsub(raw, "%s+", " ")

    if raw == "" then
        return ""
    end

    return raw
end

local function addWaypoint(rawName)
    local name = sanitizeName(rawName)
    if name == "" then
        notify("Invalid Name", "Please enter a non-empty waypoint name.")
        return
    end

    local hrp = getLocalHRP()
    if not hrp then
        notify("Error", "HumanoidRootPart not found.")
        return
    end

    Waypoints[name] = hrp.Position
    currentWaypointName = name

    notify("Waypoint Saved", "Saved waypoint '" .. name .. "'.")

    if WaypointDropdown then
        local options = {}
        for n, _ in pairs(Waypoints) do
            table.insert(options, n)
        end
        table.sort(options, function(a, b) return a:lower() < b:lower() end)

        if WaypointDropdown.Update then
            WaypointDropdown:Update(options)
        elseif WaypointDropdown.Refresh then
            WaypointDropdown:Refresh(options)
        end

        if WaypointDropdown.Set then
            WaypointDropdown:Set(currentWaypointName)
        end
    end
end

local function removeWaypoint(rawName)
    local name = sanitizeName(rawName)
    if name == "" then
        notify("Invalid Name", "Please select a valid waypoint to remove.")
        return
    end

    if not Waypoints[name] then
        notify("Not Found", "No waypoint exists with that name.")
        return
    end

    Waypoints[name] = nil
    if currentWaypointName == name then
        currentWaypointName = nil
    end

    notify("Waypoint Removed", "Removed waypoint '" .. name .. "'.")
end

local function teleportToWaypointByName(rawName)
    local name = sanitizeName(rawName)
    if name == "" then
        notify("No Selection", "Please select a waypoint first.")
        return
    end

    local pos = Waypoints[name]
    if not pos then
        notify("Not Found", "No waypoint exists with that name.")
        return
    end

    local hrp = getLocalHRP()
    if not hrp then
        notify("Error", "HumanoidRootPart not found.")
        return
    end

    hrp.CFrame = CFrame.new(pos, pos + hrp.CFrame.LookVector)
    notify("Teleported", "Teleported to waypoint '" .. name .. "'.")
end

