local tpGhostMode      = false
local tpMaxDistance    = math.huge
local tpStyle          = "Instant" -- "Instant", "Smooth", "Pulse"

local function BuildTeleportList()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player then
            local display = plr.DisplayName or plr.Name
            table.insert(list, string.format("%s (%s)", plr.Name, display))
        end
    end
    table.sort(list, function(a, b)
        return a:lower() < b:lower()
    end)
    return list
end

local function ExtractUsernameFromEntry(entry)
    if not entry then return nil end
    local name = entry:match("^([^%s]+)%s%(") or entry
    return name
end

local function findPlayerByNameOrDisplay(input)
    if not input or input == "" then return nil end
    local lower = string.lower(input)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player and string.lower(plr.Name) == lower then
            return plr
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player and string.lower(plr.DisplayName or "") == lower then
            return plr
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player then
            local uname = string.lower(plr.Name)
            local dname = string.lower(plr.DisplayName or "")
            if string.find(uname, lower, 1, true) or string.find(dname, lower, 1, true) then
                return plr
            end
        end
    end

    return nil
end

local function doInstantTeleport(target)
    local char = Player.Character or Player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        Message("Teleport", "Your HumanoidRootPart is missing.", 3)
        return
    end

    local thrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not thrp then
        Message("Teleport", "Target has no HumanoidRootPart.", 3)
        return
    end

    local targetPos = thrp.Position
    local myPos     = hrp.Position
    local dist      = (targetPos - myPos).Magnitude

    if tpSafeMode and dist > tpMaxDistance then
        Message("Teleport", "Target too far for Safe Teleport (" .. math.floor(dist) .. " > " .. math.floor(tpMaxDistance) .. ")", 3)
        return
    end

    hrp.CFrame = thrp.CFrame * CFrame.new(0, 0, -2)
end

local function doSmoothTeleport(target)
    local char = Player.Character or Player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        Message("Teleport", "Your HumanoidRootPart is missing.", 3)
        return
    end

    local thrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not thrp then
        Message("Teleport", "Target has no HumanoidRootPart.", 3)
        return
    end

    local startPos = hrp.Position
    local endPos   = thrp.Position + thrp.CFrame.LookVector * -2
    local dist     = (endPos - startPos).Magnitude

    if tpSafeMode and dist > tpMaxDistance then
        Message("Teleport", "Target too far for Safe Teleport (" .. math.floor(dist) .. " > " .. math.floor(tpMaxDistance) .. ")", 3)
        return
    end

    local charParts = {}
    if tpGhostMode then
        for _, p in ipairs(char:GetChildren()) do
            if p:IsA("BasePart") then
                table.insert(charParts, p)
            end
        end
        for _, p in ipairs(charParts) do
            p.Transparency = math.clamp(p.Transparency + 0.5, 0, 1)
        end
    end

    local duration = math.clamp(dist / 50, 0.2, 1.5)
    local t0 = tick()

    while true do
        local now  = tick()
        local alpha = (now - t0) / duration
        if alpha >= 1 then break end

        local newPos = startPos:Lerp(endPos, alpha)
        hrp.CFrame = CFrame.new(newPos, thrp.Position)
        RunService.RenderStepped:Wait()
    end

    hrp.CFrame = CFrame.new(endPos, thrp.Position)

    if tpGhostMode then
        for _, p in ipairs(charParts) do
            if p and p:IsA("BasePart") then
                p.Transparency = math.clamp(p.Transparency - 0.5, 0, 1)
            end
        end
    end
end

local function doPulseTeleport(target)
    local char = Player.Character or Player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        Message("Teleport", "Your HumanoidRootPart is missing.", 3)
        return
    end

    local thrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not thrp then
        Message("Teleport", "Target has no HumanoidRootPart.", 3)
        return
    end

    local startPos = hrp.Position
    local endPos   = thrp.Position + thrp.CFrame.LookVector * -2
    local dist     = (endPos - startPos).Magnitude

    if tpSafeMode and dist > tpMaxDistance then
        Message("Teleport", "Target too far for Safe Teleport (" .. math.floor(dist) .. " > " .. math.floor(tpMaxDistance) .. ")", 3)
        return
    end

    local hops = 5
    for i = 1, hops do
        local alpha = i / (hops + 1)
        local pos = startPos:Lerp(endPos, alpha)
        hrp.CFrame = CFrame.new(pos, thrp.Position)
        task.wait(0.05)
    end

    hrp.CFrame = CFrame.new(endPos, thrp.Position)
end

local function TeleportToPlayerByNameOrDisplay(input)
    if not input or input == "" then
        Message("Teleport", "No player specified.", 3)
        return
    end

    local target = findPlayerByNameOrDisplay(input)
    if not target then
        Message("Teleport", "Could not find a valid target matching '" .. input .. "'.", 3)
        return
    end

    if not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        Message("Teleport", "Target has no character.", 3)
        return
    end

    if tpStyle == "Smooth" then
        doSmoothTeleport(target)
    elseif tpStyle == "Pulse" then
        doPulseTeleport(target)
    else
        doInstantTeleport(target)
    end

    Message("Teleport", "Teleported to " .. target.Name .. " (" .. (target.DisplayName or target.Name) .. ")", 3)
end

