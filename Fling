TeleportTab:CreateButton({
    Name     = "Preview Teleport Path",
    Callback = function()
        local char = Player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            Message("Teleport", "Cannot preview: no HumanoidRootPart.", 3)
            return
        end

        local targetPlayer = SelectedTeleportTargetName and Players:FindFirstChild(SelectedTeleportTargetName)
        if not (targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")) then
            Message("Teleport", "Cannot preview: select a valid target.", 3)
            return
        end

        local startPos = hrp.Position
        local targetHRP = targetPlayer.Character.HumanoidRootPart
        local rawEndPos = targetHRP.Position + targetHRP.CFrame.LookVector * -2

        local dist = (rawEndPos - startPos).Magnitude
        if tpSafeMode and dist > tpMaxDistance then
            Message("Teleport", "Target too far for Safe Teleport preview (" .. math.floor(dist) .. " > " .. math.floor(tpMaxDistance) .. ")", 3)
            return
        end

        local points = {}
        local segments = 20

        if tpStyle == "Smooth" then
            local mid = (startPos + rawEndPos) / 2
            mid = mid + Vector3.new(0, math.max(6, dist / 10), 0)

            local function quadLerp(a, b, c, t)
                local ab = a:Lerp(b, t)
                local bc = b:Lerp(c, t)
                return ab:Lerp(bc, t)
            end

            for i = 0, segments do
                local t = i / segments
                table.insert(points, quadLerp(startPos, mid, rawEndPos, t))
            end

        elseif tpStyle == "Pulse" then
            local hops = 5
            for i = 0, hops do
                local alpha = i / hops
                local pos = startPos:Lerp(rawEndPos, alpha)
                pos = pos + Vector3.new(0, math.sin(alpha * math.pi) * math.max(4, dist / 12), 0)
                table.insert(points, pos)
            end

        else
            for i = 0, segments do
                local t = i / segments
                table.insert(points, startPos:Lerp(rawEndPos, t))
            end
        end

        for i = 1, #points - 1 do
            local p1 = points[i]
            local p2 = points[i + 1]
            local segDir = p2 - p1
            local length = segDir.Magnitude
            if length > 0 then
                local part = Instance.new("Part")
                part.Anchored = true
                part.CanCollide = false
                part.Color = Color3.fromRGB(0, 255, 0)
                part.Material = Enum.Material.Neon
                part.Size = Vector3.new(0.2, 0.2, length)
                part.CFrame = CFrame.new((p1 + p2) / 2, p2) * CFrame.new(0, 0, -length / 2)
                part.Parent = Workspace
                game.Debris:AddItem(part, 2)
            end
        end

        Message("Teleport", "Preview path drawn (2s).", 2)
    end,
})

