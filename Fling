    Status_Fling_StateLabel:Set("State: " .. state .. (FlingActive and "  |  Mode: Multi-Target" or ""))
    Status_Fling_TargetsLabel:Set("Targets Selected: " .. tostring(count))
    Status_Fling_CyclesLabel:Set("Fling Cycles: " .. tostring(TotalFlingCycles))
