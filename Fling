local function CountSelectedTargets()
    local count = 0
    for _ in pairs(SelectedTargets) do
        count += 1
    end
    return count
end

local function ci_contains(haystack, needle)
    haystack = string.lower(haystack or "")
    needle   = string.lower(needle or "")
    if needle == "" then return true end
    return string.find(haystack, needle, 1, true) ~= nil
end

local function MatchesFilter(plr)
    if PlayerFilterText == "" then return true end
    local uname = plr.Name or ""
    local dname = plr.DisplayName or ""
    return ci_contains(uname, PlayerFilterText) or ci_contains(dname, PlayerFilterText)
end

local function GetPlayerNames()
    local names = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player and MatchesFilter(plr) then
            table.insert(names, plr.Name)
        end
    end
    table.sort(names, function(a, b)
        return a:lower() < b:lower()
    end)
    return names
end


